        },
        "color": {
          "default": "#000000",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Color",
          "type": "string"
        },
        "blend": {
          "default": "screen",
          "enum": [
            "normal",
            "screen",
            "add",
            "overlay",
            "multiply",
            "softlight"
          ],
          "title": "Blend",
          "type": "string"
        },
        "opacity": {
          "default": 50,
          "maximum": 100,
          "minimum": 0,
