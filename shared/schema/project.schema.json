        "label": {
          "default": true,
          "title": "Label",
          "type": "boolean"
        },
        "font": {
          "default": "Be Vietnam Pro",
          "enum": [
            "Be Vietnam Pro",
            "Inter",
            "Playfair Display",
            "Montserrat",
            "Lora",
            "Quicksand"
          ],
          "title": "Font",
          "type": "string"
        },
        "size": {
          "default": 54,
          "maximum": 200,
          "minimum": 8,
          "title": "Size",
          "type": "number"
        },
        "color": {
          "default": "#ffffff",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Color",
          "type": "string"
        },
        "anim": {
          "default": "fade",
          "enum": [
            "fade",
            "slide",
            "none"
          ],
          "title": "Anim",
          "type": "string"
        },
        "pos": {
          "$ref": "#/$defs/PosByFormat"
        }
      },
      "required": [
        "name"
      ],
      "title": "NowPlayingElement",
      "type": "object"
    },
    "OverlayElement": {
