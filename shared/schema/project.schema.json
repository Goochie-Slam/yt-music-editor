        "y": {
          "default": 0.5,
          "maximum": 1,
          "minimum": 0,
          "title": "Y",
          "type": "number"
        }
      },
      "title": "Pos",
      "type": "object"
    },
    "PosByFormat": {
      "additionalProperties": false,
