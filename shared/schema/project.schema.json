{
  "$defs": {
    "Artwork": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "default": "image",
          "enum": [
            "image",
            "carousel",
            "video"
          ],
          "type": "string"
        },
        "media": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "carouselMode": {
          "default": "song",
          "enum": [
            "song",
            "interval"
          ],
          "type": "string"
        },
        "carouselEverySec": {
          "default": 60,
          "minimum": 5,
          "type": "number"
        },
        "loopCrossfade": {
          "default": true,
          "type": "boolean"
        },
        "scale": {
          "default": 100,
          "maximum": 150,
          "minimum": 40,
          "type": "number"
        },
        "radius": {
          "default": 0,
          "maximum": 60,
          "minimum": 0,
          "type": "number"
        },
        "shadow": {
          "default": true,
          "type": "boolean"
        },
        "border": {
          "default": false,
          "type": "boolean"
        },
        "pos": {
          "$ref": "#/$defs/PosByFormat"
        }
      },
      "required": [
        "type",
        "media",
        "carouselMode",
        "carouselEverySec",
        "loopCrossfade",
        "scale",
        "radius",
        "shadow",
        "border",
        "pos"
      ],
      "title": "Artwork",
      "type": "object"
    },
    "Background": {
      "additionalProperties": false,
      "properties": {
        "fit": {
          "default": "blur",
          "enum": [
            "blur",
            "solid",
            "crop"
          ],
          "type": "string"
        },
        "blur": {
          "default": 30,
          "maximum": 60,
          "minimum": 0,
          "type": "number"
        },
        "dim": {
          "default": 35,
          "maximum": 80,
          "minimum": 0,
          "type": "number"
        },
        "solid": {
          "default": "#14121c",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "type": "string"
        }
      },
      "required": [
        "fit",
        "blur",
        "dim",
        "solid"
      ],
      "title": "Background",
      "type": "object"
    },
    "Curve": {
      "enum": [
        "equal-power",
        "linear",
        "log",
        "s-curve"
      ],
      "title": "Curve",
      "type": "string"
    },
    "EffectSetting": {
      "additionalProperties": false,
      "properties": {
        "on": {
          "default": false,
          "type": "boolean"
        },
        "value": {
          "default": 0,
          "type": "number"
        }
      },
      "required": [
        "on",
        "value"
      ],
      "title": "EffectSetting",
      "type": "object"
    },
    "Effects": {
      "additionalProperties": false,
      "properties": {
        "zoom": {
          "$ref": "#/$defs/EffectSetting"
        },
        "grain": {
          "$ref": "#/$defs/EffectSetting"
        },
        "glow": {
          "$ref": "#/$defs/EffectSetting"
        },
        "dust": {
          "$ref": "#/$defs/EffectSetting"
        },
        "snow": {
          "$ref": "#/$defs/EffectSetting"
        },
        "bokeh": {
          "$ref": "#/$defs/EffectSetting"
        }
      },
      "required": [
        "zoom",
        "grain",
        "glow",
        "dust",
        "snow",
        "bokeh"
      ],
      "title": "Effects",
      "type": "object"
    },
    "ExportExtras": {
      "additionalProperties": false,
      "properties": {
        "mixMp3": {
          "default": true,
          "type": "boolean"
        },
        "chapters": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "mixMp3",
        "chapters"
      ],
      "title": "ExportExtras",
      "type": "object"
    },
    "ExportSettings": {
      "additionalProperties": false,
      "properties": {
        "formats": {
          "items": {
            "enum": [
              "16:9",
              "9:16"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "height": {
          "default": 1080,
          "enum": [
            1080,
            1440,
            2160
          ],
          "type": "integer"
        },
        "fps": {
          "default": 30,
          "enum": [
            30,
            60
          ],
          "type": "integer"
        },
        "quality": {
          "default": "balanced",
          "enum": [
            "light",
            "balanced",
            "high"
          ],
          "type": "string"
        },
        "encoder": {
          "default": "auto",
          "enum": [
            "auto",
            "nvenc",
            "x264"
          ],
          "type": "string"
        },
        "extras": {
          "$ref": "#/$defs/ExportExtras"
        }
      },
      "required": [
        "formats",
        "height",
        "fps",
        "quality",
        "encoder",
        "extras"
      ],
      "title": "ExportSettings",
      "type": "object"
    },
    "FileSource": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "file",
          "default": "file",
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "uploaded": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "path",
        "uploaded"
      ],
      "title": "FileSource",
      "type": "object"
    },
    "ImageElement": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "default": 0,
          "minimum": 0,
          "type": "number"
        },
        "end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "visible": {
          "default": true,
          "type": "boolean"
        },
        "kind": {
          "const": "image",
          "default": "image",
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "size": {
          "default": 9,
          "maximum": 40,
          "minimum": 3,
          "type": "number"
        },
        "opacity": {
          "default": 80,
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        },
        "pos": {
          "$ref": "#/$defs/PosByFormat"
        }
      },
      "required": [
        "start",
        "end",
        "id",
        "name",
        "visible",
        "kind",
        "file",
        "size",
        "opacity",
        "pos"
      ],
      "title": "ImageElement",
      "type": "object"
    },
    "LibraryExport": {
      "additionalProperties": false,
      "description": "Settings of the batch MP3 export (F1.4); remembered per project.",
      "properties": {
        "folder": {
          "default": "",
          "type": "string"
        },
        "pattern": {
          "default": "{index} - {title}",
          "type": "string"
        }
      },
      "required": [
        "folder",
        "pattern"
      ],
      "title": "LibraryExport",
      "type": "object"
    },
    "LibraryItem": {
      "additionalProperties": false,
      "description": "A segment has no cache_wav of its own: it plays a range of its parent's WAV (F1.5).",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "source": {
          "discriminator": {
            "mapping": {
              "file": "#/$defs/FileSource",
              "segment": "#/$defs/SegmentSource",
              "url": "#/$defs/UrlSource"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/FileSource"
            },
            {
              "$ref": "#/$defs/UrlSource"
            },
            {
              "$ref": "#/$defs/SegmentSource"
            }
          ]
        },
        "cacheWav": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "duration": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "srcBitrateKbps": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "srcFormat": {
          "default": "",
          "type": "string"
        },
        "srcLossless": {
          "default": false,
          "type": "boolean"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "loudness": {
          "anyOf": [
            {
              "$ref": "#/$defs/Loudness"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "title",
        "source",
        "cacheWav",
        "duration",
        "srcBitrateKbps",
        "srcFormat",
        "srcLossless",
        "error",
        "loudness"
      ],
      "title": "LibraryItem",
      "type": "object"
    },
    "Loudness": {
      "additionalProperties": false,
      "properties": {
        "integrated": {
          "type": "number"
        },
        "truePeak": {
          "type": "number"
        },
        "lra": {
          "type": "number"
        }
      },
      "required": [
        "integrated",
        "truePeak",
        "lra"
      ],
      "title": "Loudness",
      "type": "object"
    },
    "Mix": {
      "additionalProperties": false,
      "properties": {
        "targetLufs": {
          "default": -14,
          "enum": [
            -16,
            -14,
            -12
          ],
          "type": "integer"
        },
        "autoTrimSilence": {
          "default": true,
          "type": "boolean"
        },
        "fadeInStart": {
          "default": 2,
          "minimum": 0,
          "type": "number"
        },
        "fadeOutEnd": {
          "default": 5,
          "minimum": 0,
          "type": "number"
        },
        "tracks": {
          "items": {
            "$ref": "#/$defs/MixTrack"
          },
          "type": "array"
        },
        "transitions": {
          "additionalProperties": {
            "$ref": "#/$defs/Transition"
          },
          "type": "object"
        }
      },
      "required": [
        "targetLufs",
        "autoTrimSilence",
        "fadeInStart",
        "fadeOutEnd",
        "tracks",
        "transitions"
      ],
      "title": "Mix",
      "type": "object"
    },
    "MixTrack": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "libId": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "trimIn": {
          "default": 0,
          "minimum": 0,
          "type": "number"
        },
        "trimOut": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "gainDb": {
          "default": 0,
          "maximum": 6,
          "minimum": -6,
          "type": "number"
        }
      },
      "required": [
        "id",
        "libId",
        "title",
        "trimIn",
        "trimOut",
        "gainDb"
      ],
      "title": "MixTrack",
      "type": "object"
    },
    "NowPlayingElement": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "visible": {
          "default": true,
          "type": "boolean"
        },
        "kind": {
          "const": "nowPlaying",
          "default": "nowPlaying",
          "type": "string"
        },
        "fmt": {
          "default": "{index}. {title}",
          "enum": [
            "{title}",
            "{index}. {title}",
            "Now Playing — {title}"
          ],
          "type": "string"
        },
        "label": {
          "default": true,
          "type": "boolean"
        },
        "font": {
          "default": "Be Vietnam Pro",
          "enum": [
            "Be Vietnam Pro",
            "Inter",
            "Playfair Display",
            "Montserrat",
            "Lora",
            "Quicksand"
          ],
          "type": "string"
        },
        "size": {
          "default": 54,
          "maximum": 200,
          "minimum": 8,
          "type": "number"
        },
        "color": {
          "default": "#ffffff",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "type": "string"
        },
        "anim": {
          "default": "fade",
          "enum": [
            "fade",
            "slide",
            "none"
          ],
          "type": "string"
        },
        "pos": {
          "$ref": "#/$defs/PosByFormat"
        }
      },
      "required": [
        "id",
        "name",
        "visible",
        "kind",
        "fmt",
        "label",
        "font",
        "size",
        "color",
        "anim",
        "pos"
      ],
      "title": "NowPlayingElement",
      "type": "object"
    },
    "OverlayElement": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "default": 0,
          "minimum": 0,
          "type": "number"
        },
        "end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "visible": {
          "default": true,
          "type": "boolean"
        },
        "kind": {
          "const": "overlay",
          "default": "overlay",
          "type": "string"
        },
        "sub": {
          "enum": [
            "video",
            "image",
            "color"
          ],
          "type": "string"
        },
        "file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "mode": {
          "default": "gradient",
          "enum": [
            "solid",
            "gradient",
            "vignette"
          ],
          "type": "string"
        },
        "direction": {
          "default": "bottom",
          "enum": [
            "bottom",
            "top",
            "left",
            "right"
          ],
          "type": "string"
        },
        "color": {
          "default": "#000000",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "type": "string"
        },
        "blend": {
          "default": "screen",
          "enum": [
            "normal",
            "screen",
            "add",
            "overlay",
            "multiply",
            "softlight"
          ],
          "type": "string"
        },
        "opacity": {
          "default": 50,
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        },
        "loopCrossfade": {
          "default": true,
          "type": "boolean"
        }
      },
      "required": [
        "start",
        "end",
        "id",
        "name",
        "visible",
        "kind",
        "sub",
        "file",
        "mode",
        "direction",
        "color",
        "blend",
        "opacity",
        "loopCrossfade"
      ],
      "title": "OverlayElement",
      "type": "object"
    },
    "Pos": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "default": 0.5,
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "y": {
          "default": 0.5,
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "Pos",
      "type": "object"
    },
    "PosByFormat": {
      "additionalProperties": false,
      "description": "Element positions are stored separately per aspect ratio (F3.49).",
      "properties": {
        "16:9": {
          "$ref": "#/$defs/Pos"
        },
        "9:16": {
          "$ref": "#/$defs/Pos"
        }
      },
      "required": [
        "16:9",
        "9:16"
      ],
      "title": "PosByFormat",
      "type": "object"
    },
    "SegmentSource": {
      "additionalProperties": false,
      "description": "A piece cut from another library item by the tracklist splitter (F1.5).",
      "properties": {
        "kind": {
          "const": "segment",
          "default": "segment",
          "type": "string"
        },
        "parentId": {
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "type": "number"
        },
        "end": {
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "kind",
        "parentId",
        "start",
        "end"
      ],
      "title": "SegmentSource",
      "type": "object"
    },
    "TextElement": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "default": 0,
          "minimum": 0,
          "type": "number"
        },
        "end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "visible": {
          "default": true,
          "type": "boolean"
        },
        "kind": {
          "const": "text",
          "default": "text",
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "font": {
          "default": "Be Vietnam Pro",
          "enum": [
            "Be Vietnam Pro",
            "Inter",
            "Playfair Display",
            "Montserrat",
            "Lora",
            "Quicksand"
          ],
          "type": "string"
        },
        "weight": {
          "default": 600,
          "enum": [
            400,
            500,
            600,
            700,
            800
          ],
          "type": "integer"
        },
        "size": {
          "default": 40,
          "maximum": 200,
          "minimum": 8,
          "type": "number"
        },
        "color": {
          "default": "#ffffff",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "type": "string"
        },
        "shadow": {
          "default": true,
          "type": "boolean"
        },
        "anim": {
          "default": "fade",
          "enum": [
            "fade",
            "none"
          ],
          "type": "string"
        },
        "pos": {
          "$ref": "#/$defs/PosByFormat"
        }
      },
      "required": [
        "start",
        "end",
        "id",
        "name",
        "visible",
        "kind",
        "text",
        "font",
        "weight",
        "size",
        "color",
        "shadow",
        "anim",
        "pos"
      ],
      "title": "TextElement",
      "type": "object"
    },
    "Transition": {
      "additionalProperties": false,
      "properties": {
        "presetId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "smooth-blend"
        },
        "fadeOut": {
          "default": 6,
          "maximum": 20,
          "minimum": 0,
          "type": "number"
        },
        "fadeIn": {
          "default": 6,
          "maximum": 20,
          "minimum": 0,
          "type": "number"
        },
        "overlap": {
          "default": 6,
          "maximum": 20,
          "minimum": -5,
          "type": "number"
        },
        "curveOut": {
          "$ref": "#/$defs/Curve",
          "default": "equal-power"
        },
        "curveIn": {
          "$ref": "#/$defs/Curve",
          "default": "equal-power"
        },
        "edited": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "presetId",
        "fadeOut",
        "fadeIn",
        "overlap",
        "curveOut",
        "curveIn",
        "edited"
      ],
      "title": "Transition",
      "type": "object"
    },
    "UrlSource": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "url",
          "default": "url",
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "site": {
          "default": "",
          "type": "string"
        },
        "remoteId": {
          "default": "",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "url",
        "site",
        "remoteId"
      ],
      "title": "UrlSource",
      "type": "object"
    },
    "Video": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "default": "16:9",
          "enum": [
            "16:9",
            "9:16"
          ],
          "type": "string"
        },
        "background": {
          "$ref": "#/$defs/Background"
        },
        "artwork": {
          "$ref": "#/$defs/Artwork"
        },
        "effects": {
          "$ref": "#/$defs/Effects"
        },
        "elements": {
          "items": {
            "discriminator": {
              "mapping": {
                "image": "#/$defs/ImageElement",
                "nowPlaying": "#/$defs/NowPlayingElement",
                "overlay": "#/$defs/OverlayElement",
                "text": "#/$defs/TextElement",
                "visualizer": "#/$defs/VisualizerElement"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/TextElement"
              },
              {
                "$ref": "#/$defs/NowPlayingElement"
              },
              {
                "$ref": "#/$defs/ImageElement"
              },
              {
                "$ref": "#/$defs/OverlayElement"
              },
              {
                "$ref": "#/$defs/VisualizerElement"
              }
            ]
          },
          "type": "array"
        }
      },
      "required": [
        "format",
        "background",
        "artwork",
        "effects",
        "elements"
      ],
      "title": "Video",
      "type": "object"
    },
    "VisualizerElement": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "visible": {
          "default": true,
          "type": "boolean"
        },
        "kind": {
          "const": "visualizer",
          "default": "visualizer",
