        "kind": {
          "const": "nowPlaying",
          "default": "nowPlaying",
          "title": "Kind",
          "type": "string"
        },
        "fmt": {
          "default": "{index}. {title}",
          "enum": [
            "{title}",
            "{index}. {title}",
