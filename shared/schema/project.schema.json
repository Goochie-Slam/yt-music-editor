{
  "$defs": {
    "Artwork": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "default": "image",
          "enum": [
            "image",
            "carousel",
            "video"
          ],
          "title": "Type",
          "type": "string"
        },
        "media": {
          "items": {
            "type": "string"
          },
          "title": "Media",
          "type": "array"
        },
        "carouselMode": {
          "default": "song",
          "enum": [
            "song",
            "interval"
          ],
          "title": "Carouselmode",
          "type": "string"
        },
        "carouselEverySec": {
          "default": 60,
          "minimum": 5,
          "title": "Carouseleverysec",
          "type": "number"
        },
        "loopCrossfade": {
          "default": true,
          "title": "Loopcrossfade",
          "type": "boolean"
        },
        "scale": {
          "default": 100,
          "maximum": 150,
          "minimum": 40,
          "title": "Scale",
          "type": "number"
        },
        "radius": {
          "default": 0,
          "maximum": 60,
          "minimum": 0,
          "title": "Radius",
          "type": "number"
        },
        "shadow": {
          "default": true,
          "title": "Shadow",
          "type": "boolean"
        },
        "border": {
          "default": false,
          "title": "Border",
          "type": "boolean"
        },
        "pos": {
          "$ref": "#/$defs/PosByFormat"
        }
      },
      "title": "Artwork",
      "type": "object"
    },
    "Background": {
      "additionalProperties": false,
      "properties": {
        "fit": {
          "default": "blur",
          "enum": [
            "blur",
            "solid",
            "crop"
          ],
          "title": "Fit",
          "type": "string"
        },
        "blur": {
          "default": 30,
          "maximum": 60,
          "minimum": 0,
          "title": "Blur",
          "type": "number"
        },
        "dim": {
          "default": 35,
          "maximum": 80,
          "minimum": 0,
          "title": "Dim",
          "type": "number"
        },
        "solid": {
          "default": "#14121c",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Solid",
          "type": "string"
        }
      },
      "title": "Background",
      "type": "object"
    },
    "Curve": {
      "enum": [
        "equal-power",
        "linear",
        "log",
        "s-curve"
      ],
      "title": "Curve",
      "type": "string"
    },
    "EffectSetting": {
      "additionalProperties": false,
      "properties": {
        "on": {
          "default": false,
          "title": "On",
          "type": "boolean"
        },
        "value": {
          "default": 0,
          "title": "Value",
          "type": "number"
        }
      },
      "title": "EffectSetting",
      "type": "object"
    },
    "Effects": {
      "additionalProperties": false,
      "properties": {
        "zoom": {
          "$ref": "#/$defs/EffectSetting"
        },
        "grain": {
          "$ref": "#/$defs/EffectSetting"
        },
        "glow": {
          "$ref": "#/$defs/EffectSetting"
        },
        "dust": {
          "$ref": "#/$defs/EffectSetting"
        },
        "snow": {
          "$ref": "#/$defs/EffectSetting"
        },
        "bokeh": {
          "$ref": "#/$defs/EffectSetting"
        }
      },
      "title": "Effects",
      "type": "object"
    },
    "ExportExtras": {
      "additionalProperties": false,
      "properties": {
        "mixMp3": {
          "default": true,
          "title": "Mixmp3",
          "type": "boolean"
        },
        "chapters": {
          "default": false,
          "title": "Chapters",
          "type": "boolean"
        }
      },
      "title": "ExportExtras",
      "type": "object"
    },
    "ExportSettings": {
      "additionalProperties": false,
      "properties": {
        "formats": {
          "items": {
            "enum": [
              "16:9",
              "9:16"
            ],
            "type": "string"
          },
          "title": "Formats",
          "type": "array"
        },
        "height": {
          "default": 1080,
          "enum": [
            1080,
            1440,
            2160
          ],
          "title": "Height",
          "type": "integer"
        },
        "fps": {
          "default": 30,
          "enum": [
            30,
            60
          ],
          "title": "Fps",
          "type": "integer"
        },
        "quality": {
          "default": "balanced",
          "enum": [
            "light",
            "balanced",
            "high"
          ],
          "title": "Quality",
          "type": "string"
        },
        "encoder": {
          "default": "auto",
          "enum": [
            "auto",
            "nvenc",
            "x264"
          ],
          "title": "Encoder",
          "type": "string"
        },
        "extras": {
          "$ref": "#/$defs/ExportExtras"
        }
      },
      "title": "ExportSettings",
      "type": "object"
    },
    "FileSource": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "file",
          "default": "file",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "title": "FileSource",
      "type": "object"
    },
    "ImageElement": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "default": 0,
          "minimum": 0,
          "title": "Start",
          "type": "number"
        },
        "end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "visible": {
          "default": true,
          "title": "Visible",
          "type": "boolean"
        },
        "kind": {
          "const": "image",
          "default": "image",
          "title": "Kind",
          "type": "string"
        },
        "file": {
          "title": "File",
          "type": "string"
        },
        "size": {
          "default": 9,
          "maximum": 40,
          "minimum": 3,
          "title": "Size",
          "type": "number"
        },
        "opacity": {
          "default": 80,
          "maximum": 100,
          "minimum": 0,
          "title": "Opacity",
          "type": "number"
        },
        "pos": {
          "$ref": "#/$defs/PosByFormat"
        }
      },
      "required": [
        "name",
        "file"
      ],
      "title": "ImageElement",
      "type": "object"
    },
    "LibraryItem": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "source": {
          "discriminator": {
            "mapping": {
              "file": "#/$defs/FileSource",
              "segment": "#/$defs/SegmentSource",
              "url": "#/$defs/UrlSource"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/FileSource"
            },
            {
              "$ref": "#/$defs/UrlSource"
            },
            {
              "$ref": "#/$defs/SegmentSource"
            }
          ],
          "title": "Source"
        },
        "cacheWav": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cachewav"
        },
        "duration": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration"
        },
        "srcBitrateKbps": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Srcbitratekbps"
        },
        "loudness": {
          "anyOf": [
            {
              "$ref": "#/$defs/Loudness"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "title",
        "source"
      ],
      "title": "LibraryItem",
      "type": "object"
    },
    "Loudness": {
      "additionalProperties": false,
      "properties": {
        "integrated": {
          "title": "Integrated",
          "type": "number"
        },
        "truePeak": {
          "title": "Truepeak",
          "type": "number"
        },
        "lra": {
          "title": "Lra",
          "type": "number"
        }
      },
      "required": [
        "integrated",
        "truePeak",
        "lra"
      ],
      "title": "Loudness",
      "type": "object"
    },
    "Mix": {
      "additionalProperties": false,
      "properties": {
        "targetLufs": {
          "default": -14,
          "enum": [
            -16,
            -14,
            -12
          ],
          "title": "Targetlufs",
          "type": "integer"
        },
        "autoTrimSilence": {
          "default": true,
          "title": "Autotrimsilence",
          "type": "boolean"
        },
        "fadeInStart": {
          "default": 2,
          "minimum": 0,
          "title": "Fadeinstart",
          "type": "number"
        },
        "fadeOutEnd": {
          "default": 5,
          "minimum": 0,
          "title": "Fadeoutend",
          "type": "number"
        },
        "tracks": {
          "items": {
            "$ref": "#/$defs/MixTrack"
          },
          "title": "Tracks",
          "type": "array"
        },
        "transitions": {
          "additionalProperties": {
            "$ref": "#/$defs/Transition"
          },
          "title": "Transitions",
          "type": "object"
        }
      },
      "title": "Mix",
      "type": "object"
    },
    "MixTrack": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "libId": {
          "title": "Libid",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "trimIn": {
          "default": 0,
          "minimum": 0,
          "title": "Trimin",
          "type": "number"
        },
        "trimOut": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trimout"
        },
        "gainDb": {
          "default": 0,
          "maximum": 6,
          "minimum": -6,
          "title": "Gaindb",
          "type": "number"
        }
      },
      "required": [
        "libId",
        "title"
      ],
      "title": "MixTrack",
      "type": "object"
    },
    "NowPlayingElement": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
